# PIT Radar — environment variables
#
# Copy to pit-radar/.env for local runs (git-ignored), or set each one in Railway -> Variables.
# Secrets are left blank on purpose. Never commit real values. Non-secret values shown are the defaults
# from the spec (docs/04 §6, docs/05, docs/03 §4); admins can override budgets, thresholds and PIT dates
# at runtime (settings table, PUT /api/admin/settings).
# PIT_* values apply while PIT mode is on (between PIT_MODE_START and PIT_MODE_END, or when an admin
# turns it on manually).

# --- Secrets (required) ------------------------------------------------------
SOCIALCRAWL_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
ANTHROPIC_API_KEY=
# 32+ random bytes, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it logs everyone out (incident rule, docs/09 §6).
SESSION_SECRET=

# --- App ---------------------------------------------------------------------
# production | development
APP_ENV=production
# e.g. the Railway domain, https://...
APP_BASE_URL=
# daily budgets reset at local midnight
APP_TIMEZONE=America/New_York
# never DEBUG in production (DEBUG may log post text)
LOG_LEVEL=INFO
# or a Postgres URL from Railway
DATABASE_URL=sqlite:////data/pit-radar.db
# PORT is set by Railway; uvicorn reads it (default 8000).

# --- Auth (docs/07 §1, docs/09 §1) --------------------------------------------
SESSION_TTL_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# false only for local http development
COOKIE_SECURE=true

# --- Claude classifier (docs/05) ---------------------------------------------
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high
CLASSIFIER_EFFORT=medium
LLM_CONCURRENCY=4
# >= this and all checks pass -> ai_verified (mapped)
MIN_CONFIDENCE_MAP=0.70
# >= this but < MAP -> needs_human_review; below -> not stored
MIN_CONFIDENCE_REVIEW=0.50

# --- Scanning (docs/04 §6) -----------------------------------------------------
SCAN_INTERVAL_MIN=60
PIT_SCAN_INTERVAL_MIN=15
# YYYY-MM-DD, e.g. two weeks before the January count
PIT_MODE_START=
# YYYY-MM-DD, the day after the count
PIT_MODE_END=
INGEST_MAX_AGE_DAYS=30
PLACES_PER_SCAN=8
PIT_PLACES_PER_SCAN=12
HOT_PLACES_PER_SCAN=5
MAX_CLASSIFICATIONS_PER_SCAN=60
PIT_MAX_CLASSIFICATIONS_PER_SCAN=120

# --- Budgets (hard stops; docs/04 §6) ----------------------------------------
SOCIALCRAWL_CREDITS_PER_SCAN=40
PIT_SOCIALCRAWL_CREDITS_PER_SCAN=60
SOCIALCRAWL_CREDITS_PER_DAY=900
PIT_SOCIALCRAWL_CREDITS_PER_DAY=4000
EXA_SEARCHES_PER_SCAN=6
PIT_EXA_SEARCHES_PER_SCAN=10
FIRECRAWL_SEARCHES_PER_SCAN=6
PIT_FIRECRAWL_SEARCHES_PER_SCAN=10
DAILY_LLM_BUDGET_USD=5
PIT_DAILY_LLM_BUDGET_USD=20

# --- Providers (base URLs; change only if a provider moves) -------------------
SOCIALCRAWL_BASE_URL=https://www.socialcrawl.dev
SOCIALCRAWL_MAX_IN_FLIGHT=10
EXA_BASE_URL=https://api.exa.ai
FIRECRAWL_BASE_URL=https://api.firecrawl.dev

# --- Geocoding (docs/06 §3) ----------------------------------------------------
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# a LICH address; sent in the User-Agent per Nominatim policy
NOMINATIM_CONTACT_EMAIL=
NOMINATIM_MIN_INTERVAL_SEC=1.0

# --- Retention and hotspots (docs/01 R6, docs/03 §4, docs/09 §4) -------------
RETENTION_DAYS=30
PENDING_ITEM_TTL_HOURS=72
HOTSPOT_RADIUS_M=400
HOTSPOT_RADIUS_EAST_END_M=800
HALF_LIFE_DAYS=7
HOTSPOT_ARCHIVE_DAYS=90

# --- Map (docs/08 §4) -------------------------------------------------------------
# chosen free vector style [verify terms and attribution]
MAP_STYLE_URL=
# comma-separated hosts added to the CSP img-src/connect-src
MAP_TILE_HOSTS=
